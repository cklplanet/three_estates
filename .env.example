OPENROUTER_KEY=YOUR_API_KEY_HERE
THREE_ESTATES_SESSION_NAME=crossover_test_redux
# Interface and generated-language locale. Supported here: en-US, zh-CN, ja-JP.
THREE_ESTATES_LOCALE=en-US
# THREE_ESTATES_SESSION_DIR=/absolute/path/to/a/session_dir
THREE_ESTATES_CHARACTER_MODEL=openai/gpt-5.5
# THREE_ESTATES_GAME_MODEL=x-ai/grok-4.20
THREE_ESTATES_GAME_MODEL=deepseek/deepseek-v4-pro
THREE_ESTATES_DIALOGUE_MODEL=deepseek/deepseek-v4-pro
THREE_ESTATES_SPINSTER_GUESS_MODEL=deepseek/deepseek-v4-pro
THREE_ESTATES_EPILOGUE_MODEL=google/gemini-3.5-flash
THREE_ESTATES_POIGNANCY_MODEL=deepseek/deepseek-v4-flash
THREE_ESTATES_FALLBACK_MODEL=google/gemini-3.5-flash
THREE_ESTATES_MOVEMENT_LEAVE_COOLDOWN_STEPS=2
THREE_ESTATES_MOVEMENT_STAY_COOLDOWN_STEPS=4
THREE_ESTATES_STARTING_MOVEMENT_COOLDOWN_STEPS=10
THREE_ESTATES_STARTING_MOVEMENT_COOLDOWN_RADIUS=3
THREE_ESTATES_NON_SPEAKING_ACTION_COOLDOWN_DECREMENT=1
THREE_ESTATES_SPEAKING_COOLDOWN_STEPS=1
# When true, speech generation uses the dialogue model's default reasoning behavior; false explicitly disables reasoning for speech.
THREE_ESTATES_ALLOW_SPEECH_REASONING=true
# Casual posture always uses LLM chat poignancy; this controls fully strategic mode and the strategic portion of casual mode.
THREE_ESTATES_USE_LLM_CHAT_POIGNANCY_SCORING=false
THREE_ESTATES_IMPORTANCE_TRIGGER_MAX=120
THREE_ESTATES_RETENTION_BATCHES=10
THREE_ESTATES_MIN_ACTION_BID_SCORE=2
THREE_ESTATES_SECONDS_PER_PHASE=8
THREE_ESTATES_CASUAL_SECONDS_PER_PHASE=10
THREE_ESTATES_NORMAL_TIMER_URGENCY_PHASES=3
THREE_ESTATES_TRANSIT_PERSON_MEMORY_CAP=2
THREE_ESTATES_ENDGAME_TIMER_URGENCY_PHASES=3
THREE_ESTATES_ENDGAME_SECONDS_PER_PHASE=6
THREE_ESTATES_PHASE_SNAPSHOT_RETENTION=2
THREE_ESTATES_RETRIEVED_SELF_EVENT_CAP=6
THREE_ESTATES_RETRIEVED_SELF_THOUGHT_CAP=4
THREE_ESTATES_RETRIEVED_CURRENT_TABLE_EVENT_TOTAL_CAP=15
THREE_ESTATES_RETRIEVED_CURRENT_TABLE_THOUGHT_TOTAL_CAP=10
THREE_ESTATES_RETRIEVED_FOREIGN_TABLE_EVENT_TOTAL_CAP=10
THREE_ESTATES_RETRIEVED_FOREIGN_TABLE_THOUGHT_TOTAL_CAP=8
THREE_ESTATES_ENABLE_SPEAKING_COOLDOWN=True
